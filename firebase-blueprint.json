{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "mobileNumber": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin", "task_manager", "payment_manager", "support_manager", "analyst"] },
        "membershipTier": { "type": "string", "enum": ["free", "silver", "gold", "premium"] },
        "referralCode": { "type": "string", "maxLength": 30 },
        "referredBy": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "lastLoginDate": { "type": "string", "maxLength": 30 },
        "streakClaimedToday": { "type": "boolean" },
        "isAgeVerified": { "type": "boolean" },
        "guardianConsent": { "type": "boolean" },
        "privacyLeaderboard": { "type": "string", "enum": ["public", "alias", "hidden"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "fullName", "role", "membershipTier", "status"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User wallet balances and financial totals",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "availableBalance": { "type": "number" },
        "pendingBalance": { "type": "number" },
        "lifetimeEarnings": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "availableBalance", "pendingBalance", "lifetimeEarnings"]
    },
    "Task": {
      "title": "Task",
      "description": "Platform tasks published by administrators or advertisers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "taskType": { "type": "string", "enum": ["video", "website", "education", "image", "survey", "qa", "sponsored", "custom"] },
        "externalUrl": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "rewardAmount": { "type": "number" },
        "xpReward": { "type": "number" },
        "eligibleTiers": { "type": "array" },
        "minTimeOnTaskSeconds": { "type": "number" },
        "dailyLimit": { "type": "number" },
        "totalLimit": { "type": "number" },
        "completedCount": { "type": "number" },
        "instructions": { "type": "string", "maxLength": 2000 },
        "proofType": { "type": "string", "enum": ["screenshot", "text", "url"] },
        "status": { "type": "string", "enum": ["active", "paused", "expired"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "taskType", "rewardAmount", "proofType", "status"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Submission evidence submitted by users for reward verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "taskTitle": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "proofType": { "type": "string", "enum": ["screenshot", "text", "url"] },
        "proofUrl": { "type": "string", "maxLength": 500 },
        "proofText": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "flagged"] },
        "rewardAmount": { "type": "number" },
        "xpReward": { "type": "number" },
        "adminNotes": { "type": "string", "maxLength": 500 },
        "timeSpentSeconds": { "type": "number" },
        "submittedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "taskId", "userId", "status", "rewardAmount"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Payout request and settlement records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank"] },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "netAmount": { "type": "number" },
        "transactionReference": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "processing", "paid", "rejected"] },
        "requestedAt": { "type": "string", "maxLength": 50 },
        "processedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "method", "accountNumber", "amount", "status"]
    },
    "MembershipPlan": {
      "title": "MembershipPlan",
      "description": "Configurable membership tiers and benefits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "durationDays": { "type": "number" },
        "rewardMultiplier": { "type": "number" },
        "dailyTaskLimit": { "type": "number" },
        "benefits": { "type": "array" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "durationDays", "active"]
    },
    "MembershipPayment": {
      "title": "MembershipPayment",
      "description": "User payments for membership upgrades",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "planId": { "type": "string", "maxLength": 50 },
        "planName": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank"] },
        "senderAccount": { "type": "string", "maxLength": 50 },
        "transactionId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "planId", "price", "transactionId", "status"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Promotional banners, sliders, and popups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "targetUrl": { "type": "string", "maxLength": 500 },
        "placement": { "type": "string", "enum": ["popup", "banner", "slider", "offer_card", "sidebar"] },
        "active": { "type": "boolean" },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" }
      },
      "required": ["id", "title", "imageUrl", "placement", "active"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage and section hero banners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "linkUrl": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "imageUrl", "active"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Platform notices and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "enum": ["general", "tasks", "payment", "membership", "update"] },
        "important": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "content", "category"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support helpdesk requests",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "subject": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["open", "in_progress", "awaiting_user", "resolved", "closed"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "category", "subject", "status"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "System-wide configurable website settings",
      "type": "object",
      "properties": {
        "websiteName": { "type": "string", "maxLength": 100 },
        "websiteLogo": { "type": "string", "maxLength": 500 },
        "whatsAppNumber": { "type": "string", "maxLength": 30 },
        "supportEmail": { "type": "string", "maxLength": 100 },
        "minimumWithdrawal": { "type": "number" },
        "referralReward": { "type": "number" },
        "popupAnnouncement": { "type": "string", "maxLength": 1000 },
        "popupActive": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "currency": { "type": "string", "maxLength": 10 },
        "termsUrl": { "type": "string", "maxLength": 200 },
        "privacyUrl": { "type": "string", "maxLength": 200 }
      },
      "required": ["websiteName", "whatsAppNumber", "minimumWithdrawal", "currency"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "ipAddress": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "adminId", "action", "details", "timestamp"]
    },
    "PromotedApp": {
      "title": "PromotedApp",
      "description": "User or advertiser submitted apps for promotion and download rewards",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "developer": { "type": "string", "maxLength": 100 },
        "iconUrl": { "type": "string", "maxLength": 500 },
        "category": { "type": "string" },
        "downloadUrl": { "type": "string", "maxLength": 500 },
        "appType": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "xpReward": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "proofRequired": { "type": "string" },
        "rating": { "type": "number" },
        "downloadsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "status": { "type": "string" },
        "submittedBy": { "type": "string", "maxLength": 128 },
        "submittedByName": { "type": "string", "maxLength": 100 },
        "submittedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "developer", "downloadUrl", "rewardAmount", "status", "submittedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and account settings"
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "User wallet records"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Available micro-tasks"
    },
    "/taskSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/TaskSubmission" },
      "description": "Proof submissions for review"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Withdrawal payout records"
    },
    "/memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/MembershipPlan" },
      "description": "Membership tiers and benefits"
    },
    "/membershipPayments/{paymentId}": {
      "schema": { "$ref": "#/entities/MembershipPayment" },
      "description": "User membership upgrade payments"
    },
    "/advertisements/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "Promotional banners and ads"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Hero banners"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Notices and updates"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Helpdesk tickets"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Platform settings document"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit log"
    },
    "/promotedApps/{appId}": {
      "schema": { "$ref": "#/entities/PromotedApp" },
      "description": "Promoted and user-submitted apps"
    }
  }
}
